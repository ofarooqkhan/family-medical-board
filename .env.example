# Postgres connection string. On Replit this is set automatically by the managed database.
DATABASE_URL=
# OpenAI key used when the Replit AI integration variables below are not set.
OPENAI_API_KEY=
# Set by the Replit OpenAI integration. Takes precedence over OPENAI_API_KEY.
AI_INTEGRATIONS_OPENAI_API_KEY=
# Set by the Replit OpenAI integration. Base URL for the OpenAI-compatible proxy.
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Anthropic key. Not used yet; needed when item 3 (Claude extraction) lands.
ANTHROPIC_API_KEY=
